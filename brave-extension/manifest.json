{
  "manifest_version": 3,
  "name": "Capri for Brave",
  "version": "1.0.0",
  "description": "Lets Capri search and operate a dedicated Brave window when you ask.",
  "key": "",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:47823/*", "http://localhost:47823/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Capri's Brave window",
    "default_popup": "popup.html"
  }
}
