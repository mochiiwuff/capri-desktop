{
  "name": "capri-desktop",
  "version": "0.3.1",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icons/capri.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Capri-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Capri-${version}-mac-${arch}.dmg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icons/capri.png",
      "category": "Utility",
      "artifactName": "Capri-${version}-linux-${arch}.${ext}"
    }
  }
}
