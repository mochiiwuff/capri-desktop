{
  "name": "capri-desktop",
  "version": "0.4.4",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win",
    "native:mac": "node scripts/build-macos.js",
    "prestart": "node scripts/build-macos.js",
    "predev": "node scripts/build-macos.js",
    "dist:mac": "node scripts/build-macos.js --universal && electron-builder --mac --universal",
    "test:platform": "node --test tests/platform.test.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "native/bin/capri-macos",
          "to": "capri-macos"
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Capri opens coding assistant sessions in Terminal only when you ask."
      },
      "icon": "native/bin/capri.png"
    }
  }
}
