{
  "name": "capri-desktop",
  "version": "0.4.4",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win",
    "hooks:opencode:install": "node scripts/install-opencode-plugin.js",
    "hooks:opencode:uninstall": "node scripts/install-opencode-plugin.js --uninstall",
    "test:browser": "node --test tests/browser.test.js",
    "test:extension": "node --test tests/extension-worker.test.js",
    "test:voice": "node --test tests/voice.test.js",
    "test:vision": "node --test tests/vision.test.js",
    "test:evolution": "node --test tests/evolution.test.js",
    "test": "node --test tests/evolution.test.js tests/browser.test.js tests/extension-worker.test.js tests/voice.test.js tests/hooks.test.js tests/vision.test.js"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "brave-extension/**"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "brave-extension/**",
      "src/main/speech.ps1",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  }
}
